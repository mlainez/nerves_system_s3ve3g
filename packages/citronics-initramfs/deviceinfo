# Citronics initramfs deviceinfo for the Samsung Galaxy S III Neo.
#
# The initramfs sources this file; only the variables below are read. The
# partitions it mounts are resolved at boot: `nerves_base=` on the kernel
# command line names a GPT partition, so nothing here decides where the
# rootfs comes from. The recovery network uses the kernel's built-in
# g_ether, so no USB gadget identifiers are needed either.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy S III Neo (GT-I9301I)"
deviceinfo_codename="samsung-s3ve3g"
deviceinfo_arch="armv7"

# unudhcpd hands the connected host a single address (10.0.42.2, the phone
# being 10.0.42.1) so you can telnet into the initramfs over USB for
# recovery.
deviceinfo_disable_dhcpd="false"
deviceinfo_getty=""
