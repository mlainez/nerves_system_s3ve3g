# Citronics initramfs deviceinfo for the Samsung Galaxy S III Neo.
#
# The initramfs reads this file for USB-recovery details and
# human-readable identification. The partitions it mounts are resolved at
# boot: `nerves_base=` on the kernel command line names a GPT partition,
# not a device node, so nothing here decides where the rootfs comes from.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy S III Neo (GT-I9301I)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-s3ve3g"
deviceinfo_year="2014"
deviceinfo_arch="armv7"
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1280"

# The recovery path uses the kernel's built-in g_ether (see the 0005
# patch), so these identifiers only matter if a configfs gadget is ever
# used instead.
deviceinfo_usb_idVendor="0x18d1"
deviceinfo_usb_idProduct="0xd001"
deviceinfo_usb_serialnumber=""
deviceinfo_usb_network_function="ncm.usb0"

# unudhcpd hands the connected host a single address (10.0.42.2, the
# phone being 10.0.42.1) so you can telnet into the initramfs over USB for
# recovery: the same addresses as the port's rescue image.
deviceinfo_disable_dhcpd="false"
deviceinfo_getty=""
