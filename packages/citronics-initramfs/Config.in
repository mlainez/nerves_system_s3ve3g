config BR2_PACKAGE_CITRONICS_INITRAMFS
	bool "citronics-initramfs [Galaxy S III Neo]"
	depends on !BR2_STATIC_LIBS
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_BUSYBOX
	select BR2_PACKAGE_MULTIPATH_TOOLS
	help
	  Early-boot initramfs. lk2nd loads it alongside the kernel; it
	  finds the stock `userdata` partition by GPT name, maps the Nerves
	  subpartitions out of it with kpartx, mounts the squashfs rootfs
	  and pivots into it. If any of that fails it brings up USB
	  networking (10.0.42.1) and a telnet shell instead of leaving you
	  with a black screen.
