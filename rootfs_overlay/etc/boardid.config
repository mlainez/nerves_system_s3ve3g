# boardid.config
#
# erlinit runs this (-d /usr/bin/boardid) to build the hostname. That
# matters for more than cosmetics: VintageNetDirect picks the usb0 /30 by
# hashing the hostname into 172.31.0.0/16, so two phones answering to the
# same name also claim the same address.

# The Qualcomm SoC serial, exposed by the mainline socinfo driver from SMEM.
# Its probe can be deferred, and erlinit reads the ID early, so the eMMC CID
# below is the one that reliably answers in time.
#
# `-t text` emits the digits as they appear in sysfs; without it the bytes
# are hex-encoded.
-b binfile -f /sys/devices/soc0/serial_number -l 10 -t text

# The eMMC CID. Offset 20 skips the manufacturer and product-name fields,
# which are identical across units, and lands on the card's serial number.
-b binfile -f /sys/block/mmcblk0/device/cid -k 20 -l 8 -t text

# Last resort, so a device without either still gets an ID.
-b cpuinfo
