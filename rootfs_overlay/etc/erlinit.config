# Additional configuration for erlinit
#
# To override the settings in this file, see
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config.
#

# Turn on the debug prints
# -v

# Specify where erlinit should send the IEx prompt. Only one may be enabled at
# a time. tty1 is the phone's screen: lk2nd leaves the panel lit and the
# kernel drives it through simpledrm and fbcon. There is no UART without
# opening the phone; over USB, use ssh to the address VintageNetDirect gives
# usb0.
-c tty1

# If more than one tty are available, always warn if the user is looking at the
# wrong one.
--warn-unused-tty

# Use nbtty to improve terminal handling on serial ports. It's a noop on HDMI.
-s "/usr/bin/nbtty"

# Specify the user and group IDs for the Erlang VM
#--uid 100
#--gid 200

# Uncomment to ensure that the system clock is set to at least the Nerves
# System's build date/time. If you enable this, you'll still need to use NTP or
# another mechanism to set the clock, but it won't be decades off.
#--update-clock

# Uncomment to hang the board rather than rebooting when Erlang exits
# NOTE: Do not enable on production boards
#--hang-on-exit

# Change the graceful shutdown time. If 10 seconds isn't long enough between
# calling "poweroff", "reboot", or "halt" and :init.stop/0 stopping all OTP
# applications, enable this option with a new timeout in milliseconds.
#--graceful-shutdown-timeout 15000

# Optionally run a program if the Erlang VM exits
#--run-on-exit /bin/sh

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mounts (run "man fstab" for field names). The /dev/nerves-* names are
# symlinks the initramfs creates after looking partitions up by GPT name and
# mapping the nested MBR in `userdata`; see fwup_include/fwup-common.conf.
# If /root fails to mount because it is new or corrupt, nerves_runtime
# formats it.
-m debugfs:/sys/kernel/debug:debugfs:nodev,noexec,nosuid:
-m pstore:/sys/fs/pstore:pstore:nodev,noexec,nosuid:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:
-m /dev/nerves-boot:/boot:ext2:ro,nodev,noexec,nosuid:
-m /dev/nerves-app:/root:f2fs:nodev:

# Stock Android partitions holding this phone's own firmware, read-only.
# Nothing in this system writes to them. `noload` stops the ext4 driver from
# replaying a journal on a read-only mount; shortname=lower gives the FAT
# 8.3 names on apnhlos the lower-case spelling the drivers ask for.
-m /dev/nerves-apnhlos:/mnt/apnhlos:vfat:ro,nodev,noexec,nosuid:shortname=lower
-m /dev/nerves-system:/mnt/system:ext4:ro,nodev,noexec,nosuid:noload

# Link the WCNSS firmware from those mounts into /run/firmware and load the
# Wi-Fi and Bluetooth drivers, before Erlang starts. Always exits 0.
--pre-run-exec /usr/sbin/s3ve3g-bringup

# Erlang release search path
-r /srv/erlang

# Assign a hostname of the form "nerves-<last 4 chars of the serial number>".
# See /etc/boardid.config for locating the serial number.
-d /usr/bin/boardid
-n nerves-%-.4s

# If using shoehorn (https://github.com/nerves-project/shoehorn), start the
# shoehorn OTP release up first. If shoehorn isn't around, erlinit fails back
# to the main OTP release.
--boot shoehorn
