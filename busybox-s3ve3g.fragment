# Busybox config fragment for nerves_system_s3ve3g.
#
# Appended on top of board/nerves-common/busybox.config, which is
# deliberately minimal: erlinit and the OTP release do the work, and most
# applets are off. The citronics initramfs needs a small Unix userland of
# its own to:
#
#   * map the Nerves subpartitions out of the stock `userdata` partition
#     and pivot into the squashfs rootfs (switch_root)
#   * open a recovery shell over USB (telnetd / getty) when that fails
#   * run the handful of text and filesystem helpers its init script uses
#
# Buildroot appends this file to .config after `make oldconfig`, so a
# setting here wins over the base config. One busybox serves both the
# initramfs and the rootfs, so every applet below ends up in the squashfs
# too.

# --- Subpartition symlinks and the pivot --------------------------------------
CONFIG_LN=y
CONFIG_SWITCH_ROOT=y
CONFIG_FEATURE_INSTALLER=y

# --- Helpers the init and functions.sh scripts invoke -------------------------
CONFIG_CHMOD=y
CONFIG_TOUCH=y
CONFIG_HEAD=y
CONFIG_CUT=y
CONFIG_SED=y
CONFIG_WC=y
CONFIG_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_FEATURE_TEST_64=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_UNAME=y
# functions.sh waits for devices with `for i in $(seq 1 $timeout)`; without
# seq the loop body never runs and the script gives up at once.
CONFIG_SEQ=y
# start_unudhcpd checks for a running daemon with pidof.
CONFIG_PIDOF=y
CONFIG_FEATURE_PIDOF_SINGLE=y
CONFIG_FEATURE_PIDOF_OMIT=y

# --- Recovery shell over USB networking (fail_halt_boot) ----------------------
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_GETTY=y

# --- Filesystem helpers for the recovery shell --------------------------------
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_INSMOD=y
